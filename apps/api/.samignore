# ══════════════════════════════════════════════════════════════
# .samignore — Excluir arquivos desnecessários do pacote Lambda
# Objetivo: manter o unzipped size < 250MB
# ══════════════════════════════════════════════════════════════

# Docs e specs
docs/
*.md
!README.md

# Frontend (deployado separadamente via S3)
apps/frontend/
apps/web/

# Testes
__tests__/
*.test.js
*.spec.js
coverage/
jest.config.*

# Dev tools
.git/
.github/
.vscode/
.idea/

# Node dev dependencies (não precisam no Lambda)
node_modules/.cache/
node_modules/nodemon/
node_modules/jest*/
node_modules/@jest/
node_modules/ts-jest/
node_modules/babel-jest/

# Sharp - pre-built binaries para plataformas não-Linux
node_modules/sharp/build/Release/obj/
node_modules/sharp/vendor/
node_modules/sharp/src/
node_modules/sharp/docs/
node_modules/@img/sharp-win32*/
node_modules/@img/sharp-darwin*/
node_modules/@img/sharp-linuxmusl*/

